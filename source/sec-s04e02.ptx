    <p>
      Convert the following fractions to decimals. If necessary, round the result to 2 decimal places.  
    </p>
    <sidebyside>
     <exercise workspace="0.35in">
        <p><m>\frac{3}{4}</m></p>
    </exercise>
    <exercise workspace="0.35in">
        <p><m>-\frac{5}{6}</m></p>
    </exercise>   
    </sidebyside>
    <sidebyside>
