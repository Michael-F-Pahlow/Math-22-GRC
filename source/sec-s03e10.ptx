        </exercise>
    </sidebyside>
     <sidebyside>
        <exercise workspace="0.75in">
            <p><m>\frac{17}{10}</m></p>
        </exercise>
        <exercise workspace="0.75in">
            <p><m>\frac{23}{8}</m></p>
        </exercise>
