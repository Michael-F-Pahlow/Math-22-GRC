        </exercise>
    </sidebyside>
    <p>
        Convert each of the following improper fractions to a mixed number.
    </p>
    <sidebyside>
        <exercise workspace="0.75in">
            <p><m>\frac{7}{4}</m></p>
        </exercise>
        <exercise workspace="0.75in">
            <p><m>\frac{10}{3}</m></p>
        </exercise>
        <exercise workspace="0.75in">
            <p><m>\frac{8}{5}</m></p>
        </exercise>
    </sidebyside>
    <sidebyside>
        <exercise workspace="0.75in">
            <p><m>\frac{9}{5}</m></p>
        </exercise>
        <exercise workspace="0.75in">
            <p><m>\frac{15}{7}</m></p>
        </exercise>
        <exercise workspace="0.75in">
            <p><m>\frac{19}{12}</m></p>
        </exercise>
    </sidebyside>
    <sidebyside>
        <exercise workspace="0.75in">
