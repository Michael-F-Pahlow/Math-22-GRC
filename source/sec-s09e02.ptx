        </image>
    </exercise>
  </sidebyside>
  <sidebyside>
    <exercise workspace="2.5in">
      <p>
        <m>y=\frac{4}{5}x</m>
      </p>
      <image width="70%">
      <shortdescription>blank xy-plane</shortdescription>
        <prefigure label="pf-xy-plane9" xmlns="https://prefigure.org">
